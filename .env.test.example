# Copy this file to .env.test (gitignored). Test-only settings, loaded by
# vitest.setup.ts before .env. It points the database-backed test suites at the
# local test database from docker compose (service "postgres", loopback port
# 55432). Never point these tests at the production database.
#
#   Copy-Item .env.test.example .env.test
#   docker compose up -d postgres
#   docker compose run --rm migrate
#   npx vitest run

DATABASE_URL=postgresql://parmana:parmana-local@127.0.0.1:55432/parmana

# The database-backed suites run only with this opt-in (resolveDatabaseGate).
# It is set here because this database is local and disposable.
ALLOW_LIVE_SUPABASE=1
