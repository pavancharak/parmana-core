# Copy this file to .env.test (gitignored). It is the only file a test run reads for
# database settings. vitest.setup.ts loads it; .env is never read by tests
# (docs/internal/designs/TEST-DATABASE-CONFIG.md).
#
# Choose ONE option below. The default is option A.
#
# A. Local Docker database (development). Nothing else is needed.
#
#   Copy-Item .env.test.example .env.test
#   docker compose up -d postgres
#   docker compose run --rm migrate
#   npx vitest run
#
# B. A hosted TEST project (never the production project). Replace option A with these
#    lines, using the test project's ID and connection string from the Supabase dashboard:
#
#   TEST_DATABASE_URL=<connection string for the test project>
#   PARMANA_TEST_PROJECT_REFS=<test project ID>
#   ALLOW_LIVE_SUPABASE=1
#   PARMANA_DATABASE_CA_FILE=
#
#   A hosted run refuses unless its project is listed in PARMANA_TEST_PROJECT_REFS and
#   ALLOW_LIVE_SUPABASE=1 is set. Production is refused even if listed, when its ID is in
#   PARMANA_PRODUCTION_PROJECT_REFS. Set that list in your shell, not in this file.

# Option A: local Docker database.
DATABASE_URL=postgresql://parmana:parmana-local@127.0.0.1:55432/parmana

# Opt-in for the database-backed suites (resolveDatabaseGate). Harmless for a local database.
ALLOW_LIVE_SUPABASE=1

# Empty, so a PARMANA_DATABASE_CA_FILE in .env cannot turn on TLS for this local database.
PARMANA_DATABASE_CA_FILE=
