# PRODUCTION DATABASE STACK (<ACCOUNT_ID>). Step 2 of the production build.
# Uses the network from infra/parmana-prod-network (IDs passed in prod.tfvars).
# The master password is generated by Terraform (random_password) and stored only in the
# parmana/prod/database-url secret, as a full connection string for the API. Keep the state file private.

terraform {
  required_version = ">= 1.5"
  required_providers {
    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
    random = { source = "hashicorp/random", version = "~> 3.6" }
  }
}

provider "aws" {
  region  = var.region
  profile = var.aws_profile

  default_tags {
    tags = {
      project     = "parmana"
      environment = var.environment
      managed-by  = "terraform"
    }
  }
}

variable "region" {
  type    = string
  default = "ap-south-1"
}

variable "environment" {
  type    = string
  default = "prod"
}

variable "aws_profile" {
  type        = string
  default     = "parmana-prod"
  description = "AWS CLI profile for this account, from aws configure sso. Not root credentials."
}

variable "expected_account_id" {
  type        = string
  description = "The one AWS account this stack may run in."
}

variable "vpc_id" {
  type = string
}

variable "private_subnet_ids" {
  type        = list(string)
  description = "Two private subnets from the network stack, in different AZs."
}

variable "database_security_group_id" {
  type = string
}

variable "instance_class" {
  type    = string
  default = "db.t4g.micro"
}

variable "allocated_storage" {
  type    = number
  default = 20
}

variable "backup_retention_days" {
  type    = number
  default = 7
}

data "aws_caller_identity" "current" {}

check "account_guard" {
  assert {
    condition     = data.aws_caller_identity.current.account_id == var.expected_account_id
    error_message = "Signed in to account ${data.aws_caller_identity.current.account_id}, expected ${var.expected_account_id}. Stop."
  }
}

resource "aws_db_subnet_group" "main" {
  name       = "parmana-${var.environment}"
  subnet_ids = var.private_subnet_ids

  tags = { Name = "parmana-${var.environment}" }
}

resource "aws_db_instance" "main" {
  identifier = "parmana-${var.environment}"

  engine         = "postgres"
  engine_version = "16"
  instance_class = var.instance_class

  allocated_storage     = var.allocated_storage
  max_allocated_storage = 100
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = "parmana"
  username = "parmana_admin"

  # Password comes from random_password below. It is never written in code.
  password = random_password.master.result

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [var.database_security_group_id]
  publicly_accessible    = false
  multi_az               = false

  deletion_protection       = true
  skip_final_snapshot       = false
  final_snapshot_identifier = "parmana-${var.environment}-final"
  copy_tags_to_snapshot     = true

  backup_retention_period = var.backup_retention_days
  backup_window           = "20:00-21:00"
  maintenance_window      = "sun:21:00-sun:22:00"

  auto_minor_version_upgrade = true
  apply_immediately          = false
}

output "database_endpoint" {
  value = aws_db_instance.main.address
}

output "database_port" {
  value = aws_db_instance.main.port
}

output "database_url_secret_arn" {
  description = "Secrets Manager secret holding the full DATABASE_URL for the API."
  value       = aws_secretsmanager_secret.database_url.arn
}

resource "random_password" "master" {
  length  = 32
  special = false
}

# Full connection string for the API. Read by App Runner as DATABASE_URL.
# Recovery window is kept at 30 days so an accidental delete can be undone.
resource "aws_secretsmanager_secret" "database_url" {
  name                    = "parmana/${var.environment}/database-url"
  description             = "DATABASE_URL for the Parmana API (production)"
  recovery_window_in_days = 30
}

resource "aws_secretsmanager_secret_version" "database_url" {
  secret_id     = aws_secretsmanager_secret.database_url.id
  secret_string = "postgresql://${aws_db_instance.main.username}:${random_password.master.result}@${aws_db_instance.main.address}:${aws_db_instance.main.port}/${aws_db_instance.main.db_name}?sslmode=require"
}
