{
  "policyId": "high-value-payment",
  "policyVersion": "1.0.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes high-value vendor payments only with a signed approval from the Finance Director for this vendor, covering this amount. No agent action is authorized without a signed human approval.",
  "signalsSchema": {
    "vendorVerified": "boolean",
    "invoiceVerified": "boolean",
    "paymentApproved": "boolean",
    "sufficientFunds": "boolean",
    "paymentAmount": "number",
    "riskScore": "number",
    "financeDirectorApproved": "boolean"
  },
  "boundSignals": {
    "paymentAmount": "parameters.amount"
  },
  "unboundSignalReasons": {
    "vendorVerified": "Independently attested by upstream vendor verification; no Intent-side equivalent field exists to bind against.",
    "invoiceVerified": "Result of an independent invoice-verification check; not a value the Intent itself declares.",
    "paymentApproved": "Attested by a separate payment-approval step; the Intent carries no approval-status field to bind against.",
    "sufficientFunds": "Result of an independent funds-availability check against account state; not expressible via the Intent's target/parameters.",
    "riskScore": "A computed payment-risk score, not a value the caller's Intent declares or could be checked against."
  },
  "approvalSignals": {
    "financeDirectorApproved": {
      "resourceId": "target",
      "value": "parameters.amount"
    }
  },
  "rules": [
    {
      "id": "approve-high-value-payment",
      "condition": {
        "all": [
          {
            "fact": "vendorVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "invoiceVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sufficientFunds",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 10000
          },
          {
            "fact": "financeDirectorApproved",
            "operator": "is_true"
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "High-value vendor payment authorized after Finance Director approval."
      }
    },
    {
      "id": "reject-high-value-without-director-approval",
      "condition": {
        "all": [
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 10000
          },
          {
            "fact": "financeDirectorApproved",
            "operator": "eq",
            "value": false
          }
        ]
      },
      "outcome": {
        "action": "reject",
        "reason": "High-value vendor payment rejected because Finance Director approval is required."
      }
    },
    {
      "id": "approve-payment",
      "condition": {
        "all": [
          {
            "fact": "financeDirectorApproved",
            "operator": "is_true"
          },
          {
            "fact": "vendorVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "invoiceVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sufficientFunds",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 0
          },
          {
            "fact": "paymentAmount",
            "operator": "lte",
            "value": 10000
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Vendor payment authorized."
      }
    },
    {
      "id": "reject-high-risk-payment",
      "condition": {
        "fact": "riskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the assessed payment risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-unverified-vendor",
      "condition": {
        "fact": "vendorVerified",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the vendor has not been verified."
      }
    },
    {
      "id": "reject-unverified-invoice",
      "condition": {
        "fact": "invoiceVerified",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the invoice has not been verified."
      }
    },
    {
      "id": "reject-payment-not-approved",
      "condition": {
        "fact": "paymentApproved",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the required payment approval has not been granted."
      }
    },
    {
      "id": "reject-insufficient-funds",
      "condition": {
        "fact": "sufficientFunds",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because sufficient funds are not available."
      }
    },
    {
      "id": "reject-invalid-payment-amount",
      "condition": {
        "fact": "paymentAmount",
        "operator": "lte",
        "value": 0
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the payment amount must be greater than zero."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because one or more required policy conditions were not satisfied."
      }
    }
  ]
}
