#
# ==================================================
# Parmana Production Configuration
# ==================================================
#

#
# Storage Backend
#
# Supported values:
#   memory
#   supabase
#
PARMANA_STORAGE=supabase

#
# Supabase
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

#
# Policy Repository
#
PARMANA_POLICY_DIRECTORY=policies

#
# Execution Authorization
#
PARMANA_AUTHORIZATION_TTL_SECONDS=120

#
# Runtime
#
NODE_ENV=production

#
# Logging
#
LOG_LEVEL=info

#
# Optional
#
# PARMANA_SIGNING_KEY=...
# PARMANA_VERIFYING_KEY=...