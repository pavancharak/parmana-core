{
  "policyId": "payment-limit",
  "policyVersion": "2.0.0",
  "schemaVersion": "1.0.0",
  "signalsSchema": {
    "vendorVerified": "boolean",
    "invoiceVerified": "boolean",
    "paymentApproved": "boolean",
    "sufficientFunds": "boolean",
    "paymentAmount": "number",
    "riskScore": "number"
  },
  "rules": [
    {
      "id": "approve-payment",
      "condition": {
        "all": [
          {
            "fact": "vendorVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "invoiceVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sufficientFunds",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 0
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Vendor payment authorized."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "One or more policy conditions were not satisfied."
      }
    }
  ],
  "signalSources": {
    "invoiceVerified": {
      "source": "trusted-test",
      "claim": "fact.invoiceVerified",
      "subject": "target"
    },
    "paymentAmount": {
      "source": "trusted-test",
      "claim": "fact.paymentAmount",
      "subject": "target"
    },
    "paymentApproved": {
      "source": "trusted-test",
      "claim": "fact.paymentApproved",
      "subject": "target"
    },
    "riskScore": {
      "source": "trusted-test",
      "claim": "fact.riskScore",
      "subject": "target"
    },
    "sufficientFunds": {
      "source": "trusted-test",
      "claim": "fact.sufficientFunds",
      "subject": "target"
    },
    "vendorVerified": {
      "source": "trusted-test",
      "claim": "fact.vendorVerified",
      "subject": "target"
    }
  }
}
