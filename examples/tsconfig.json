{
  "extends": "../tsconfig.base.json",

  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,

    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true
  },

  "include": ["**/*.ts"]
}
