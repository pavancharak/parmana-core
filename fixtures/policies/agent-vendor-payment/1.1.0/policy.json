{
  "policyId": "agent-vendor-payment",
  "policyVersion": "1.1.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes an autonomous agent's payment to a vendor after validating the vendor is on the agent's allowlist, the payment stays within the agent's credential limit, and the agent has not exceeded its payment velocity limit. Every authorization also needs a signed approval from a trusted person for this target, covering this amount, in signals.approvalArtifact with humanApproved true. The other signals can only refuse, never authorize on their own.",
  "signalsSchema": {
    "humanApproved": "boolean",
    "vendorAllowed": "boolean",
    "withinCredentialLimit": "boolean",
    "withinVelocityLimit": "boolean",
    "paymentAmount": "number",
    "vendorId": "string"
  },
  "boundSignals": {
    "paymentAmount": "parameters.amount",
    "vendorId": "target"
  },
  "unboundSignalReasons": {},
  "approvalSignals": {
    "humanApproved": {
      "resourceId": "target",
      "value": "parameters.amount"
    }
  },
  "rules": [
    {
      "id": "approve-agent-payment",
      "condition": {
        "all": [
          {
            "fact": "humanApproved",
            "operator": "is_true"
          },
          {
            "fact": "vendorAllowed",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "withinCredentialLimit",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "withinVelocityLimit",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 0
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Agent payment authorized. Vendor allowlist, credential limit, and velocity requirements were satisfied, with a verified human approval."
      }
    },
    {
      "id": "reject-vendor-not-allowed",
      "condition": {
        "fact": "vendorAllowed",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Agent payment rejected because the vendor is not on the agent's authorized vendor list."
      }
    },
    {
      "id": "reject-credential-limit-exceeded",
      "condition": {
        "fact": "withinCredentialLimit",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Agent payment rejected because the payment amount exceeds the agent's credential limit."
      }
    },
    {
      "id": "reject-velocity-exceeded",
      "condition": {
        "fact": "withinVelocityLimit",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Agent payment rejected because the agent exceeded its allowed payment velocity."
      }
    },
    {
      "id": "reject-invalid-payment-amount",
      "condition": {
        "fact": "paymentAmount",
        "operator": "lte",
        "value": 0
      },
      "outcome": {
        "action": "reject",
        "reason": "Agent payment rejected because the payment amount must be greater than zero."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Agent payment rejected because one or more required policy conditions were not satisfied."
      }
    }
  ],
  "signalSources": {
    "vendorAllowed": {
      "source": "trusted-test",
      "claim": "fact.vendorAllowed",
      "subject": "target"
    },
    "withinCredentialLimit": {
      "source": "trusted-test",
      "claim": "fact.withinCredentialLimit",
      "subject": "target"
    },
    "withinVelocityLimit": {
      "source": "trusted-test",
      "claim": "fact.withinVelocityLimit",
      "subject": "target"
    }
  }
}
