{
  "policyId": "access-control",
  "policyVersion": "1.1.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes access requests using authentication, authorization, multi-factor authentication, device trust, and session risk evaluation. Every authorization also needs a signed approval from a trusted person for this target, in signals.approvalArtifact with humanApproved true. The other signals can only refuse, never authorize on their own.",
  "signalsSchema": {
    "humanApproved": "boolean",
    "userAuthenticated": "boolean",
    "userAuthorized": "boolean",
    "mfaVerified": "boolean",
    "deviceTrusted": "boolean",
    "sessionRiskScore": "number"
  },
  "unboundSignalReasons": {},
  "approvalSignals": {
    "humanApproved": {
      "resourceId": "target"
    }
  },
  "rules": [
    {
      "id": "approve-access",
      "condition": {
        "all": [
          {
            "fact": "humanApproved",
            "operator": "is_true"
          },
          {
            "fact": "userAuthenticated",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "userAuthorized",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "mfaVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "deviceTrusted",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sessionRiskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Access authorized. Authentication, authorization, multi-factor authentication, device trust, and session risk requirements were satisfied, with a verified human approval."
      }
    },
    {
      "id": "reject-high-risk-session",
      "condition": {
        "fact": "sessionRiskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because the assessed session risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-untrusted-device",
      "condition": {
        "fact": "deviceTrusted",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because the requesting device is not trusted."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Access rejected because one or more required authorization conditions were not satisfied."
      }
    }
  ],
  "signalSources": {
    "deviceTrusted": {
      "source": "trusted-test",
      "claim": "fact.deviceTrusted",
      "subject": "target"
    },
    "mfaVerified": {
      "source": "trusted-test",
      "claim": "fact.mfaVerified",
      "subject": "target"
    },
    "sessionRiskScore": {
      "source": "trusted-test",
      "claim": "fact.sessionRiskScore",
      "subject": "target"
    },
    "userAuthenticated": {
      "source": "trusted-test",
      "claim": "fact.userAuthenticated",
      "subject": "target"
    },
    "userAuthorized": {
      "source": "trusted-test",
      "claim": "fact.userAuthorized",
      "subject": "target"
    }
  }
}
