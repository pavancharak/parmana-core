{
  "policyId": "vendor-payment",
  "policyVersion": "2.1.0",
  "schemaVersion": "1.0.0",
  "description": "Authorizes vendor payments after validating vendor eligibility, invoice verification, payment approval, available funds, and payment risk assessment. Every authorization also needs a signed approval from a trusted person for this target, covering this amount, in signals.approvalArtifact with humanApproved true. The other signals can only refuse, never authorize on their own.",
  "signalsSchema": {
    "humanApproved": "boolean",
    "vendorVerified": "boolean",
    "invoiceVerified": "boolean",
    "paymentApproved": "boolean",
    "sufficientFunds": "boolean",
    "paymentAmount": "number",
    "riskScore": "number",
    "vendorId": "string"
  },
  "boundSignals": {
    "paymentAmount": "parameters.amount",
    "vendorId": "target"
  },
  "unboundSignalReasons": {},
  "approvalSignals": {
    "humanApproved": {
      "resourceId": "target",
      "value": "parameters.amount"
    }
  },
  "rules": [
    {
      "id": "approve-payment",
      "condition": {
        "all": [
          {
            "fact": "humanApproved",
            "operator": "is_true"
          },
          {
            "fact": "vendorVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "invoiceVerified",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentApproved",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "sufficientFunds",
            "operator": "eq",
            "value": true
          },
          {
            "fact": "paymentAmount",
            "operator": "gt",
            "value": 0
          },
          {
            "fact": "riskScore",
            "operator": "lte",
            "value": 20
          }
        ]
      },
      "outcome": {
        "action": "approve",
        "reason": "Vendor payment authorized. Vendor verification, invoice verification, payment approval, funding, and risk assessment requirements were satisfied, with a verified human approval."
      }
    },
    {
      "id": "reject-high-risk-payment",
      "condition": {
        "fact": "riskScore",
        "operator": "gt",
        "value": 20
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the assessed payment risk exceeds the maximum permitted threshold."
      }
    },
    {
      "id": "reject-unverified-vendor",
      "condition": {
        "fact": "vendorVerified",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the vendor has not been verified."
      }
    },
    {
      "id": "reject-unverified-invoice",
      "condition": {
        "fact": "invoiceVerified",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the invoice has not been verified."
      }
    },
    {
      "id": "reject-payment-not-approved",
      "condition": {
        "fact": "paymentApproved",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the required payment approval has not been granted."
      }
    },
    {
      "id": "reject-insufficient-funds",
      "condition": {
        "fact": "sufficientFunds",
        "operator": "eq",
        "value": false
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because sufficient funds are not available."
      }
    },
    {
      "id": "reject-invalid-payment-amount",
      "condition": {
        "fact": "paymentAmount",
        "operator": "lte",
        "value": 0
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because the payment amount must be greater than zero."
      }
    },
    {
      "id": "reject-default",
      "condition": {
        "always": true
      },
      "outcome": {
        "action": "reject",
        "reason": "Vendor payment rejected because one or more required policy conditions were not satisfied."
      }
    }
  ],
  "signalSources": {
    "vendorVerified": {
      "source": "trusted-test",
      "claim": "vendor.verified",
      "subject": "target"
    },
    "invoiceVerified": {
      "source": "trusted-test",
      "claim": "invoice.verified",
      "subject": "target"
    },
    "paymentApproved": {
      "source": "trusted-test",
      "claim": "payment.approved",
      "subject": "target"
    },
    "sufficientFunds": {
      "source": "trusted-test",
      "claim": "funds.sufficient",
      "subject": "target"
    },
    "riskScore": {
      "source": "trusted-test",
      "claim": "payment.risk-score",
      "subject": "target",
      "maxAgeSeconds": 60
    }
  }
}
