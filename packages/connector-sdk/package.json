{
  "name": "@parmana/connector-sdk",
  "version": "0.3.1",
  "private": false,
  "description": "Connector authoring contracts and reference implementations for Parmana, the authorization layer for AI execution",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "keywords": [
    "parmana",
    "ai",
    "governance",
    "authorization",
    "connector",
    "integration",
    "agentic-ai",
    "sdk"
  ],
  "homepage": "https://docs.parmanasystems.com",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
