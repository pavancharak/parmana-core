{
  "name": "@parmana/connector-github",
  "version": "0.1.0",
  "description": "GitHub connector for Parmana, the authorization layer for AI execution: pull request fetch and merge, ephemeral GitHub App installation token credential model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
