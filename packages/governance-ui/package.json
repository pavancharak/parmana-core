{
  "name": "@parmana/governance-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Policy Governance internal UI: propose/list/diff-review for pending policy changes. Read-only by design -- approve/reject stay CLI-only via scripts/sign-policy-change-step-up.ts, since step-up's security depends on the checker's private key never leaving their machine.",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express-session": "^1.18.0",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
