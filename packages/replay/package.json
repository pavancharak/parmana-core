    "dotenv": "^18.0.9",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
