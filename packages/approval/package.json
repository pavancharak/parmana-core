{
  "name": "@parmana/approval",
  "version": "0.1.0",
  "private": true,
  "description": "Verifies signed Approval Artifacts issued by an external business authority, independent of the AI caller and of Parmana's own runtime",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rmdir /s /q dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@parmana/crypto": "0.1.0",
    "@parmana/envelope-verifier": "0.1.0",
    "@parmana/policy": "0.1.1",
    "@parmana/shared": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "SEE LICENSE IN LICENSE"
}
