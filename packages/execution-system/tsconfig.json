{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "composite": true,

    "declaration": true,
    "declarationMap": true,

    "tsBuildInfoFile": "dist/.tsbuildinfo"
  },

  "include": ["src/**/*.ts"],

  "exclude": ["dist", "node_modules", "tests"],

  "references": [
    {
      "path": "../shared"
    }
  ]
}
