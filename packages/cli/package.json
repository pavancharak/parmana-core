{
  "name": "@parmana/cli",
  "version": "3.0.1",
  "description": "Command-line tool for Parmana policy governance: propose a policy change, sign and submit a checker's step-up approval, and verify or export the signed approval log.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "parmana-ops": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@parmana/crypto": "3.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
