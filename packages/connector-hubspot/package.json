{
  "name": "@parmana/connector-hubspot",
  "version": "0.1.0",
  "private": true,
  "description": "HubSpot Deal connector for Parmana, the authorization layer for AI execution: dealstage and amount updates on CRM Objects API deals only.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@parmana/approval": "0.1.0",
    "@parmana/connector-sdk": "0.3.0",
    "@parmana/crypto": "0.1.0",
    "@parmana/envelope-verifier": "0.1.0",
    "@parmana/execution-system": "0.1.0",
    "@parmana/policy": "0.1.1",
    "@parmana/shared": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
