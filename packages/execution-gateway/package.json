{
  "name": "@parmana/execution-gateway",
  "version": "2.0.0",
  "description": "The sole boundary through which Parmana releases approved execution requests to connectors, binding each release to the exact authorized content",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@parmana/connector-sdk": "2.0.0",
    "@parmana/crypto": "2.0.0",
    "@parmana/envelope-verifier": "2.0.0",
    "@parmana/execution-control": "2.0.0",
    "@parmana/execution-system": "2.0.0",
    "@parmana/policy": "2.0.0",
    "@parmana/shared": "2.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0"
}
