{
  "name": "@parmana/storage",
  "version": "0.1.0",
  "private": true,
  "description": "Parmana Storage Engine - Append-only execution ledger system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rmdir /s /q dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@parmana/connector-sdk": "0.3.0",
    "@parmana/crypto": "0.1.0",
    "@parmana/envelope-verifier": "0.1.0",
    "@parmana/shared": "0.1.0",
    "@supabase/supabase-js": "^2.118.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "vitest": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "dotenv": "^18.0.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "SEE LICENSE IN LICENSE"
}
