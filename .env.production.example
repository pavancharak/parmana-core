# Production settings for the Parmana API on Vercel.
# Copy each name into Vercel with: npx vercel env add NAME production
# Do not put real values in this file. Lines marked REPLACE are yours to fill in from your records.

NODE_ENV=production
LOG_LEVEL=info
PARMANA_STORAGE=supabase
CRYPTO_MODE=single
PRIMARY_SIGNATURE_PROVIDER=ed25519
HASH_PROVIDER=sha256
TRUST_PROFILE=v1
RECEIPT_VERSION=1
EXECUTION_AUTHORIZATION_TTL_SECONDS=120
RATE_LIMIT_EXECUTE_PER_MINUTE=30
RATE_LIMIT_HEALTH_PER_MINUTE=300
PARMANA_GATEWAY_KEY_ID=gateway
PARMANA_POLICY_DIR=./policies
PAYTM_CONNECTOR_TIMEOUT_MS=10000

# REPLACE: your Supabase connection string (Database settings, connection string)
DATABASE_URL=postgresql://REPLACE

# REPLACE: keys issued today, set as Secret
PARMANA_API_KEYS=REPLACE
POLICY_CHANGE_CHECKERS=REPLACE

# REPLACE: from your Paytm connector setup
PAYTM_CONNECTOR_URL=https://REPLACE
PAYTM_CONNECTOR_SHARED_SECRET=REPLACE

# REPLACE: signing setup, from your records. Do not guess these.
KEY_PROVIDER=REPLACE
PARMANA_KEY_DIR=REPLACE
PARMANA_KEY_MATERIAL_JSON=REPLACE
