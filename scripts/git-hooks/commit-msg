#!/usr/bin/env bash
#
# Commit-msg hook: makes sure the commit carries a Developer Certificate of
# Origin sign-off.
#
# Every commit must carry a "Signed-off-by: Name <email>" line (CONTRIBUTING.md,
# "Commit requirements"). The DCO check in CI fails any pull request without
# one. If the message has no sign-off, this hook adds one from the configured
# git identity (git config user.name and user.email), so nobody has to retype
# the commit with -s. It fails only when no identity is configured, because
# then the sign-off would name nobody.
# Wired in by the root package.json "prepare" script (core.hooksPath).
#
# Git passes the path of the commit message file as $1.

set -euo pipefail

message_file="$1"

if grep -qE '^Signed-off-by: .+ <.+>$' "$message_file"; then
  exit 0
fi

name="$(git config user.name || true)"
email="$(git config user.email || true)"

if [ -z "$name" ] || [ -z "$email" ]; then
  echo ""
  echo "commit-msg: no Signed-off-by line, and git has no user.name or user.email to add one."
  echo "Set them, then commit again:"
  echo "  git config --global user.name \"Your Name\""
  echo "  git config --global user.email \"you@example.com\""
  echo ""
  exit 1
fi

git interpret-trailers --in-place --if-exists doNothing \
  --trailer "Signed-off-by: $name <$email>" "$message_file"
echo "commit-msg: added Signed-off-by: $name <$email>"
exit 0
