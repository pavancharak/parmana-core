#!/usr/bin/env bash
#
# Commit-msg hook: requires a Developer Certificate of Origin sign-off.
#
# Every commit must carry a "Signed-off-by: Name <email>" line (CONTRIBUTING.md,
# "Commit requirements"). The DCO check in CI fails any pull request without
# one, so this catches it before the commit exists. Add it with `git commit -s`.
# Wired in by the root package.json "prepare" script (core.hooksPath).
#
# Git passes the path of the commit message file as $1.

set -euo pipefail

message_file="$1"

if ! grep -qE '^Signed-off-by: .+ <.+>$' "$message_file"; then
  echo ""
  echo "commit-msg: this commit has no Signed-off-by line, so the DCO check would fail."
  echo "Commit again with:  git commit --amend -s     (or  git commit -s  for a new commit)"
  echo "The sign-off certifies the Developer Certificate of Origin for you as the committer."
  echo ""
  exit 1
fi