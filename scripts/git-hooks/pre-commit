#!/usr/bin/env bash
#
# Pre-commit hook: secret scan, formatting, then lint and typecheck.
# Wired in automatically by the root package.json "prepare" script (git
# config core.hooksPath scripts/git-hooks), which runs on every
# `npm install`, no manual setup step for contributors.
#
# Step 1, secret-scanning (added 2026-07-21 after an incident review
# found real Supabase and payment-provider test-mode credentials in a local,
# gitignored .env file -- that specific file was never committed
# (verified against full git history on every ref), but the review
# found no automated guard that would have caught it if it had been
# staged by mistake, this hook is that guard) -- blocks a commit if
# gitleaks finds a likely secret in the staged changes. Runs first,
# deliberately: it's seconds, not minutes, so an obvious secret fails
# fast.
#
# Step 2, format the staged files, then lint and typecheck. These take seconds.
#
# Step 3, regenerate scripts/apply-all-migrations.sql when a migration is part
# of the commit, and stage it. CI fails when the committed bundle differs from
# a fresh build, so this keeps the two in step.
#
# The full preflight (all tests, build and examples) and the database check
# run in the pre-push hook, once per push, not once per commit. CI runs them
# on every pull request as well.
# Skip with a targeted `git commit --no-verify` only when you have a specific,
# understood reason (see the repo's own git-safety guidance on never skipping
# hooks without explicit justification).

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$REPO_ROOT/.gitleaks.toml"

# Node 24 check, before any slow step. On another major version the build
# passes but the tests fail for reasons unrelated to the change (see
# CONTRIBUTING.md, "Install Node.js 24"). Failing here gives one clear message.
node_major="$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo none)"
if [ "$node_major" != "24" ]; then
  echo ""
  echo "pre-commit: Node 24 is required (found: $(node -v 2>/dev/null || echo none))."
  echo "Switch to Node 24.x (see .nvmrc), run 'npm rebuild re2', then retry. Commit blocked."
  echo ""
  exit 1
fi
run_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks protect --staged --config "$CONFIG" --redact
    return $?
  fi

  if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    docker run --rm -v "$REPO_ROOT:/repo" -w /repo \
      zricethezav/gitleaks:latest \
      protect --staged --config .gitleaks.toml --redact
    return $?
  fi

  return 127
}

if run_gitleaks; then
  status=0
else
  status=$?
fi

if [ "$status" -ne 0 ]; then
  # gitleaks exits 1 only when it finds a leak. Any other failure means the
  # scanner itself did not run, so the commit is blocked without claiming a leak.
  if [ "$status" -ne 1 ] && [ "$status" -ne 127 ]; then
    echo ""
    echo "pre-commit: the secret scanner failed (exit $status). It did not report a leak."
    echo "Check gitleaks runs ('gitleaks version'), then retry. Commit blocked."
    echo ""
    exit "$status"
  fi

  if [ "$status" -eq 127 ]; then
    echo ""
    echo "pre-commit: gitleaks is not installed and Docker is not available, cannot scan staged changes for secrets."
    echo "Install gitleaks (https://github.com/gitleaks/gitleaks#installing) or install Docker, then retry."
    echo "This commit is blocked until one of those is available. Do not bypass with --no-verify unless you have"
    echo "manually reviewed every staged file for credentials."
    echo ""
    exit 1
  fi

  echo ""
  echo "pre-commit: gitleaks found a likely secret in staged changes, see above. Commit blocked."
  echo "If this is a false positive (a placeholder, a test fixture, a known-fake example value), add it to"
  echo "the [allowlist] section of .gitleaks.toml with a comment explaining why it's safe, do not bypass with"
  echo "--no-verify to skip a real finding."
  echo ""
  exit "$status"
fi

echo ""
echo "pre-commit: gitleaks clean."
echo ""

# Format staged files, so a formatting difference cannot block the commit. A
# file with unstaged changes is skipped, so only content the commit already
# includes is ever staged here. The preflight still checks format on push.
format_staged() {
  local file
  while IFS= read -r -d '' file; do
    if git diff --quiet -- "$file"; then
      npx prettier --write --ignore-unknown -- "$file" >/dev/null
      git add -- "$file"
    fi
  done < <(git diff --cached --name-only --diff-filter=ACM -z)
}

cd "$REPO_ROOT"

format_staged

# Keep the generated migration bundle in step with supabase/migrations. Only
# runs when a migration is part of this commit. The bundle is regenerated and
# staged, so the commit always carries a bundle that matches the migrations.
if git diff --cached --name-only | grep -q '^supabase/migrations/'; then
  echo "pre-commit: a migration changed, regenerating scripts/apply-all-migrations.sql."
  npm run --silent generate:migration-bundle
  git add -- scripts/apply-all-migrations.sql
fi

echo "pre-commit: lint and typecheck."
npm run lint
npm run typecheck

echo ""
echo "pre-commit: clean. The full preflight runs on push."
exit 0
