#!/usr/bin/env bash
#
# Pre-push hook: refuses any push that would change main.
#
# Changes reach main only through a pull request, after the required CI checks
# pass on it. Push a branch and open a pull request instead. Wired in by the
# root package.json "prepare" script (core.hooksPath scripts/git-hooks).
#
# Git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>

set -euo pipefail

blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: a push to main is blocked (local ${local_ref} -> main)."
    blocked=1
  fi
done

if [ "$blocked" -ne 0 ]; then
  echo ""
  echo "Push a branch instead, for example:"
  echo "  git push -u origin HEAD:<your-branch>"
  echo "then open a pull request. Merge only after CI is green."
  echo "This check is not bypassed by a force push."
  exit 1
fi

exit 0
